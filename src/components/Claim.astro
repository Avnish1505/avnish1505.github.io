---
import { claims, sourceUrl, sourceLabel, type ClaimId } from '../data/claims';

interface Props {
  id: ClaimId;
}

const c = claims[Astro.props.id];
const label = sourceLabel(c.source);
---
<a class="claim" href={sourceUrl(c.source)}>{c.value}<span class="sr-only">, {c.label}. Source: {label}</span><span class="pop" aria-hidden="true"><span class="pop-label">{c.label}</span><span class="pop-src">{label}</span></span></a>

<style>
  .claim {
    position: relative;
    color: inherit;
    text-decoration: none;
    white-space: nowrap;
    font-variant-numeric: tabular-nums lining-nums;
    /* a highlighter swipe, not an underline */
    background: linear-gradient(transparent 56%, var(--mark) 56%, var(--mark) 94%, transparent 94%);
    padding-inline: 0.08em;
    border-radius: 2px;
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
    transition: background-color 120ms;
  }
  .claim:hover,
  .claim:focus-visible {
    background: var(--mark-strong);
  }
  .pop {
    display: none;
  }
  @media (hover: hover) {
    .claim:hover .pop,
    .claim:focus-visible .pop {
      display: grid;
      gap: 4px;
      position: absolute;
      z-index: 20;
      left: var(--pop-shift, -0.5rem);
      bottom: calc(100% + 10px);
      width: max-content;
      max-width: min(20rem, 80vw);
      padding: 10px 12px;
      white-space: normal;
      text-align: left;
      background: var(--bg-raised);
      border: 1px solid var(--line-strong);
      border-radius: 10px;
      box-shadow: var(--shadow);
      font-family: var(--serif);
      font-size: 0.8rem;
      font-weight: 400;
      line-height: 1.4;
      color: var(--text);
      letter-spacing: 0;
      pointer-events: none;
      animation: pop-in 120ms ease-out;
    }
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(4px);
    }
  }
  .pop-src {
    font-family: var(--mono);
    font-size: 0.72rem;
    color: var(--text-dim);
    overflow-wrap: anywhere;
  }
</style>

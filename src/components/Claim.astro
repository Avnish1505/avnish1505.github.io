---
import { claims, sourceUrl, sourceLabel, type ClaimId } from '../data/claims';

interface Props {
  id: ClaimId;
}

const c = claims[Astro.props.id];
const label = sourceLabel(c.source);
---
<a class="claim" href={sourceUrl(c.source)} title={`${c.label}. Source: ${label}`}>{c.value}<span class="sr">, source: {label}</span></a>

<style>
  .claim {
    text-decoration: none;
    white-space: nowrap;
    font-variant-numeric: tabular-nums lining-nums;
    background-image: linear-gradient(var(--mark), var(--mark));
    background-size: 100% 0.2em;
    background-position: 0 92%;
    background-repeat: no-repeat;
    padding-inline: 0.04em;
  }
  .claim:hover,
  .claim:focus-visible {
    background-image: linear-gradient(var(--mark-soft), var(--mark-soft));
    background-size: 100% 100%;
    box-shadow: inset 0 -0.2em 0 var(--mark);
  }
  .sr {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
  }
</style>

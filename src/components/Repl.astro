---
// The hero: the bug this work keeps finding, as a Python session.
---
<figure class="repl" aria-labelledby="repl-cap">
  <div class="repl-top" aria-hidden="true">
    <span class="dot"></span><span class="dot"></span><span class="dot"></span>
    <span class="repl-name">python3</span>
  </div>
  <pre class="repl-body"><code><span class="l l1"><span class="ps">&gt;&gt;&gt;</span> out = agent.run(task)</span>
<span class="l l2"><span class="ps">&gt;&gt;&gt;</span> out.checks_passed</span>
<span class="l l3 ok">True</span>
<span class="l l4"><span class="ps">&gt;&gt;&gt;</span> out.is_correct</span>
<span class="l l5 no">False</span>
<span class="l l6"><span class="ps">&gt;&gt;&gt;</span> <span class="cursor"></span></span></code></pre>
  <figcaption id="repl-cap" class="repl-note">
    <svg class="arrow" viewBox="0 0 60 40" aria-hidden="true"><path d="M58 8 C 40 4, 18 10, 8 30" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round"/><path d="M4 22 L8 31 L16 26" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"/></svg>
    No error was raised. That is the bug I look for.
  </figcaption>
</figure>

<style>
  .repl {
    position: relative;
    margin: 2.2rem 0 0;
    max-width: 30rem;
  }
  .repl-top {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 9px 14px;
    background: var(--bg-sunk);
    border: 1px solid var(--line);
    border-bottom: 0;
    border-radius: 12px 12px 0 0;
  }
  .dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    border: 1.5px solid var(--line-strong);
  }
  .repl-name {
    margin-left: 8px;
    font-family: var(--mono);
    font-size: 0.74rem;
    color: var(--text-faint);
  }
  .repl-body {
    margin: 0;
    border-radius: 0 0 12px 12px;
    font-size: 0.95rem;
    line-height: 1.75;
    padding: 14px 18px 16px;
  }
  .l {
    display: inline-block;
    opacity: 0;
    animation: type-in 0.01s linear forwards;
  }
  .l1 { animation-delay: 0.25s; }
  .l2 { animation-delay: 0.85s; }
  .l3 { animation-delay: 1.25s; }
  .l4 { animation-delay: 1.85s; }
  .l5 { animation-delay: 2.35s; }
  .l6 { animation-delay: 2.75s; }
  .ps {
    color: var(--text-faint);
  }
  .ok {
    color: var(--mint);
  }
  .no {
    color: var(--rose);
    font-weight: 700;
  }
  .cursor {
    display: inline-block;
    width: 0.55em;
    height: 1.05em;
    vertical-align: -0.15em;
    background: var(--text-dim);
    animation: blink 1.1s steps(1) 3s infinite;
  }
  .repl-note {
    font-family: var(--hand);
    font-weight: 700;
    font-size: 1.4rem;
    line-height: 1.15;
    color: var(--rose);
    margin-top: 0.6rem;
    padding-left: 3.2rem;
    position: relative;
    opacity: 0;
    animation: type-in 0.4s ease-out 2.9s forwards;
  }
  .arrow {
    position: absolute;
    left: 0.4rem;
    top: -1.6rem;
    width: 2.6rem;
    height: 1.9rem;
    transform: scaleY(-1) rotate(-8deg);
  }
  @media (min-width: 64rem) {
    .repl-note {
      position: absolute;
      left: calc(100% + 1rem);
      top: 9.2rem;
      width: 13rem;
      padding-left: 0;
      margin-top: 0;
      transform: rotate(-3deg);
    }
    .arrow {
      left: -2.9rem;
      top: -0.2rem;
      transform: rotate(-4deg) scaleX(1);
    }
  }
  @keyframes type-in {
    to {
      opacity: 1;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .l,
    .repl-note {
      opacity: 1;
      animation: none;
    }
    .cursor {
      animation: none;
    }
  }
</style>

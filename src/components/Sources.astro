---
import { claims, sourceUrl, sourceLabel, type ClaimId } from '../data/claims';

interface Props {
  ids: ClaimId[];
}

const items = [...new Set(Astro.props.ids)].map((id) => ({ id, ...claims[id] }));
---
<section class="sources" aria-labelledby="sources-heading">
  <h2 id="sources-heading">Where each number comes from</h2>
  <p class="muted small">
    Links point to a fixed commit, so they keep showing the same evidence even after the project changes.
    A check in this site's CI downloads each file and fails the build if a number no longer matches.
  </p>
  <table>
    <thead>
      <tr><th scope="col">Value</th><th scope="col">What it is</th><th scope="col">Evidence</th></tr>
    </thead>
    <tbody>
      {items.map((c) => (
        <tr>
          <td class="v">{c.value}</td>
          <td>{c.label}</td>
          <td><a href={sourceUrl(c.source)}>{sourceLabel(c.source)}</a>{c.source.kind === 'derived' && <span class="muted"> ({c.source.derivation} Script: <code>{c.source.script}</code>)</span>}</td>
        </tr>
      ))}
    </tbody>
  </table>
</section>

<style>
  .sources {
    margin-top: 4rem;
    padding-top: 2rem;
    border-top: 1px solid var(--rule);
  }
  h2 {
    margin-bottom: 0.6rem;
  }
  .sources > p {
    margin-bottom: 1.25rem;
  }
  table {
    display: block;
    overflow-x: auto;
    width: 100%;
    font-family: var(--sans);
    font-size: 0.84rem;
    line-height: 1.45;
  }
  th {
    text-align: left;
    font-weight: 600;
    color: var(--muted);
    padding: 0 1rem 0.5rem 0;
  }
  td {
    padding: 0.45rem 1rem 0.45rem 0;
    vertical-align: top;
    border-top: 1px solid var(--rule);
  }
  .v {
    white-space: nowrap;
    font-weight: 600;
  }
  code {
    font-size: 0.95em;
  }
</style>

---
import '@fontsource-variable/literata/opsz.css';
import '@fontsource-variable/literata/opsz-italic.css';
import '@fontsource/caveat/latin-700.css';
import '@fontsource-variable/jetbrains-mono/wght.css';
import '../styles/global.css';
import { site } from '../site.config';

interface Props {
  title?: string;
  description?: string;
  ogImage?: string;
  jsonLd?: Record<string, unknown>;
}

const { title, description = site.description, ogImage = '/og/default.png', jsonLd } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : `${site.name}: ${site.headline}`;
const origin = Astro.site ?? new URL('http://localhost:4321');
const canonical = new URL(Astro.url.pathname, origin).href;
const image = new URL(ogImage, origin).href;
const path = Astro.url.pathname;
const nav = [
  { href: '/#work', label: 'Work', match: '/work' },
  { href: '/research/', label: 'Research', match: '/research' },
  { href: '/writing/', label: 'Writing', match: '/writing' },
  { href: '/about/', label: 'About', match: '/about' },
];
const updated = new Date(site.updated + 'T00:00:00Z').toLocaleDateString('en-GB', {
  day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC',
});
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta name="theme-color" content="#edf1ec" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#1b2230" media="(prefers-color-scheme: dark)" />
    <script is:inline>
      // Apply a saved theme before first paint so the page never flashes.
      try {
        var t = localStorage.getItem('as:theme');
        if (t === 'light' || t === 'dark') document.documentElement.setAttribute('data-theme', t);
      } catch (e) {}
    </script>

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title ? pageTitle : site.ogTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={title ? `${title}, by ${site.name}` : site.headline} />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title ? pageTitle : site.ogTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="topbar">
      <div class="topbar-inner">
        <a class="brand" href="/">Avnish<span class="brand-long"> Singh</span></a>
        <nav class="site-nav" aria-label="Main">
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.match) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
        <button class="icon-btn" id="themeBtn" type="button" aria-label="Switch between dark and light">
          <svg class="i-sun" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><circle cx="12" cy="12" r="4.2" fill="none" stroke="currentColor" stroke-width="2"></circle><path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path></svg>
          <svg class="i-moon" viewBox="0 0 24 24" width="20" height="20" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path></svg>
        </button>
      </div>
      <div class="progress" aria-hidden="true"><span id="progressBar"></span></div>
    </header>
    <main id="main" class="wrap sheet" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <p><span class="hand">Every highlighted number is a link.</span> It goes to the file, test run, or commit it came from, and a check in CI fails the build if the number stops matching.</p>
        <p>Last updated {updated}. <a href={`mailto:${site.email}`}>{site.email}</a></p>
      </div>
    </footer>
    <script>
      const root = document.documentElement;
      const btn = document.getElementById('themeBtn');
      btn?.addEventListener('click', () => {
        const current = root.getAttribute('data-theme')
          ?? (matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        const next = current === 'light' ? 'dark' : 'light';
        root.setAttribute('data-theme', next);
        try { localStorage.setItem('as:theme', next); } catch {}
      });

      // Reading progress along the bottom edge of the top bar.
      const bar = document.getElementById('progressBar');
      let ticking = false;
      const update = () => {
        const max = document.documentElement.scrollHeight - innerHeight;
        if (bar) bar.style.width = max > 40 ? `${Math.min(100, (scrollY / max) * 100)}%` : '0';
        ticking = false;
      };
      addEventListener('scroll', () => {
        if (!ticking) { ticking = true; requestAnimationFrame(update); }
      }, { passive: true });
      update();

      // Keep a claim's source card inside the window.
      document.addEventListener('pointerover', (e) => {
        const claim = (e.target as HTMLElement).closest?.('.claim') as HTMLElement | null;
        if (!claim) return;
        claim.style.removeProperty('--pop-shift');
        requestAnimationFrame(() => {
          const pop = claim.querySelector('.pop');
          if (!pop) return;
          const r = pop.getBoundingClientRect();
          const over = r.right - (document.documentElement.clientWidth - 12);
          if (over > 0) claim.style.setProperty('--pop-shift', `calc(-0.5rem - ${Math.ceil(over)}px)`);
        });
      });
    </script>
  </body>
</html>

---
import Base from './Base.astro';
import Sources from '../components/Sources.astro';
import type { ClaimId } from '../data/claims';

interface Props {
  title: string;
  dek: string;
  description: string;
  year: string;
  stack: string[];
  links: { label: string; href: string }[];
  sources: ClaimId[];
  ogImage?: string;
}

const { title, dek, description, year, stack, links, sources, ogImage } = Astro.props;
---
<Base title={title} description={description} ogImage={ogImage}>
  <article>
    <header>
      <p class="crumb"><a href="/#work">Selected work</a></p>
      <h1>{title}</h1>
      <p class="dek">{dek}</p>
      <dl class="facts">
        <div><dt>Year</dt><dd>{year}</dd></div>
        <div><dt>Built with</dt><dd>{stack.join(', ')}</dd></div>
      </dl>
      <ul class="links">
        {links.map((l) => <li><a href={l.href}>{l.label}</a></li>)}
      </ul>
    </header>
    <div class="prose">
      <slot />
    </div>
    <Sources ids={sources} />
  </article>
</Base>

<style>
  .crumb {
    font-family: var(--sans);
    font-size: 0.9rem;
    margin-bottom: 1.25rem;
  }
  .crumb a {
    color: var(--muted);
    text-decoration: none;
  }
  .crumb a:hover {
    color: var(--ink);
  }
  h1 {
    font-size: clamp(2.1rem, 1.5rem + 3vw, 3.1rem);
    line-height: 1.06;
    letter-spacing: -0.024em;
    font-weight: 660;
  }
  .dek {
    font-size: 1.2rem;
    line-height: 1.5;
    margin: 0.9rem 0 1.6rem;
    color: var(--muted);
  }
  .facts {
    display: grid;
    gap: 0.3rem;
    margin: 0 0 1rem;
    font-family: var(--sans);
    font-size: 0.9rem;
  }
  .facts div {
    display: grid;
    grid-template-columns: 6.5rem 1fr;
    gap: 1rem;
  }
  .facts dt {
    color: var(--muted);
  }
  .facts dd {
    margin: 0;
  }
  .prose {
    margin-top: 2.5rem;
  }
  .prose :global(h2) {
    margin: 2.9rem 0 0.9rem;
  }
  .prose :global(ul) {
    max-width: var(--measure);
    padding-left: 1.2rem;
    margin: 0 0 1em;
  }
  .prose :global(li) {
    margin-bottom: 0.45rem;
  }
  .prose :global(li::marker) {
    color: var(--muted);
  }
  .prose :global(.table-scroll) {
    overflow-x: auto;
    margin: 1rem 0 1.5rem;
  }
  .prose :global(.table-scroll table) {
    font-family: var(--sans);
    font-size: 0.92rem;
    min-width: 24rem;
  }
  .prose :global(.table-scroll th),
  .prose :global(.table-scroll td) {
    text-align: left;
    padding: 0.5rem 1.4rem 0.5rem 0;
    border-bottom: 1px solid var(--rule);
    vertical-align: top;
  }
  .prose :global(.table-scroll thead th) {
    color: var(--muted);
    font-weight: 500;
    font-size: 0.84rem;
  }
  .prose :global(.table-scroll tbody th) {
    font-weight: 500;
  }
  .prose :global(pre) {
    margin: 1rem 0 1.5rem;
  }
</style>
